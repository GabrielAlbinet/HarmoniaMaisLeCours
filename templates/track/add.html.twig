{% extends 'base.html.twig' %}

{% block title %}Harmonia {{ album.title }} edit{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ album.artist.stageName }}</h1>
        <h2>{{ album.title }}</h2>
        {{ form_start(form) }}
            <div class="row">
                <div class="col-4">
                    {{ form_row(form.title) }}
                </div>
                <div class="col-4">
                    {{ form_row(form.duration) }}
                </div>
                <div class="col-4">
                    {{ form_row(form.number) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% extends 'admin/base.html.twig' %}

{% block title %}Harmonia Artists{% endblock %}

{% block content %}

    <div class="d-flex mb-3">
        <h2>Artistes</h2>
        <a class="btn btn-success ms-3 my-auto" href="{{ path('admin_artist_new') }}">Ajouter</a>
    </div>
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Stage name</th>
                <th>Country</th>
                <th>Albums</th>
                <th>Created at</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for artist in artists %}
                <tr>
                    <td>{{ artist.stageName }}</td>
                    <td>{{ artist.country }}</td>
                    <td>{{ artist.albums|length }}</td>
                    <td>{{ artist.createdAt|date('d/m/Y') }}</td>
                    <td>
                        <a href="{{ path('admin_artist_show', {'id': artist.id}) }}" class="btn btn-sm btn-outline-primary">Show</a>
                        <a href="{{ path('admin_artist_edit', {'id': artist.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No artist.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

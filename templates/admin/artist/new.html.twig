{% extends 'admin/base.html.twig' %}

{% block title %}Harmonia Artist Manager{% endblock %}

{% block content %}

    <div class="container">

        <h1>Ajouter un artiste</h1>

        {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6 col-12">
                    {{ form_row(form.stageName) }}
                </div>
                <div class="col-md-6 col-12">
                    {{ form_row(form.country) }}
                </div>
            </div>
        {{ form_end(form) }}
    </div>

{% endblock %}

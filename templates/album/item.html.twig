{% extends 'base.html.twig' %}

{% block title %}Harmonia {{ album.title }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-6 col-12">
            <div class="text-center">
                <h1 class="card-title">{{ album.title }} - {{ duration|date('H:i:s') }}</h1>
                <span class="badge text-bg-secondary">{{ album.type }}</span>
                <p class="card-text">Artist : {{ album.artist.stageName }} - Released : {{ album.releasedAt|date('m/Y') }}</p>
                <p class="card-text">Number of tracks : {{ album.tracks|length }}</p>
                <a href="{{ path('app_artist_show', {'id': album.artist.id}) }}" class="btn btn-primary">Artist Page</a>
                <a href="{{ path('app_track_add', {'id': album.id}) }}" class="btn btn-primary">Add Track</a>
                <ul class="list-unstyled">
                    {% for track in album.tracks %}
                        <li><a href="{{ path('app_track_item', {'id': track.id}) }}">{{ track.title }}</a> : {{ track.duration|date('i:s') }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-lg-6 col-12">
            <img src="{{ asset(album.poster) }}" class="img-fluid d-flex mx-auto" alt="...">
        </div>
    </div>
{% endblock %}

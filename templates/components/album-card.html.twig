<a href="{{ path('app_album_item', {'id': album.id}) }}" class="text-decoration-none">
    <div class="card shadow" style="width: 18rem;">
        <img src="{{ asset(album.poster) }}" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">
                {{ album.title }}
                <span class="badge text-bg-secondary ms-2">{{ album.type }}</span>
            </h5>
            <p class="card-text p-0">Artist : {{ album.artist.stageName }}</p>
            <p class="card-text p-0">Number of tracks : {{ album.tracks|length }}</p>
        </div>
    </div>
</a>
